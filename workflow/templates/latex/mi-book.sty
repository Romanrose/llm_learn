%% Long-form book profile for llm_learn course notes.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{mi-book}[2026/08/11 llm_learn book profile]

\RequirePackage{geometry,fancyhdr,titlesec}
\geometry{paperwidth=6in,paperheight=9in,margin=.8in}
\linespread{1.32}
\numberwithin{equation}{section}

\pagestyle{fancy}
\fancyhf{}
\setlength{\headheight}{14pt}
\renewcommand{\headrulewidth}{.4pt}
\fancyhead[LE]{\nouppercase{\leftmark}}
\fancyhead[RO]{\nouppercase{\rightmark}}
\fancyfoot[LE,RO]{\textcolor{MIBrand}{\thepage}}
\fancyfoot[LO,RE]{\textcolor{MIBrand}{llm\_learn / Course Notes}}
\fancypagestyle{plain}{\fancyhf{}\renewcommand{\headrulewidth}{0pt}
  \fancyfoot[LE,RO]{\textcolor{MIBrand}{\thepage}}}

\titleformat{\part}[display]{\filcenter\bfseries\color{MIDark}}
  {\Large Part \thepart}{.6em}{\Huge}[\vspace{.7em}{\color{MIBrand}\rule{7cm}{1.1pt}}]
\titlespacing*{\part}{0pt}{\fill}{\fill}
\titleformat{\chapter}[display]{\bfseries\color{MIDark}}
  {\Large 第\thechapter 章}{.4em}{\Huge}[\vspace{.4em}{\color{MIBrand}\rule{6cm}{.8pt}}]
\titlespacing*{\chapter}{0pt}{1.2em}{.8em}
\titleformat{\section}{\Large\bfseries\color{MIDark}}{\thesection}{.6em}{}

\newcommand{\MakeBookCover}[3]{%
  \thispagestyle{empty}\vspace*{\fill}\begin{center}
  {\bfseries\fontsize{30}{36}\selectfont\color{MIDark}#1\par}\vspace{.5em}
  {\fontsize{16}{22}\selectfont #2\par}\vspace{1em}
  {\color{MIBrand}\textbf{#3}\par}\vspace{1.2em}
  {\small\today\par}\end{center}\vspace*{\fill}\clearpage}
