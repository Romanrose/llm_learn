# Copy this file to .env and fill in values for your local machine.
# .env is ignored by Git. Do not commit API keys or cookies.

# Model services (inherited by KrillinAI and other local tools)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# DeepSeek API (OpenAI-compatible)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Course automation executables
# Relative paths are resolved from the repository root by the course command.
COURSE_KRILLINAI=workflow/video/krillinai/krillinai-cli
COURSE_YT_DLP=workflow/video/transcript-pipeline/.venv/bin/yt-dlp
COURSE_SUBTITLE_TOOL=/Users/your-name/.codex/skills/video-subtitle-transcript/scripts/subtitle_transcript.py
COURSE_GENERATOR=codex

# Optional local PDF compiler override. GitHub Actions installs XeLaTeX itself.
XELATEX=xelatex
