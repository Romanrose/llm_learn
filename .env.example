# Copy this file to .env and fill in values for your local machine.
# .env is ignored by Git. Do not commit API keys or cookies.

# Model services (inherited by KrillinAI and other local tools)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# DeepSeek API (OpenAI-compatible)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Course automation executables
# Run `npm run workflow:bootstrap` first. Relative paths are resolved from the repository root.
# Leave these unset to use the reproducible defaults installed under workflow/.runtime/.
COURSE_YT_DLP=
COURSE_SUBTITLE_TOOL=workflow/scripts/subtitle-transcript.mjs
# Optional: only required when overriding COURSE_SUBTITLE_TOOL with a Python script.
COURSE_PYTHON=
# Optional: install KrillinAI separately before setting this path. It is not bundled or committed.
COURSE_KRILLINAI=
COURSE_GENERATOR=codex

# Optional local PDF compiler override. GitHub Actions installs XeLaTeX itself.
XELATEX=xelatex
